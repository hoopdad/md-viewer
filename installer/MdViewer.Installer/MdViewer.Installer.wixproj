<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <InstallerPlatform Condition="'$(InstallerPlatform)' == ''">$(Platform)</InstallerPlatform>
    <OutputName Condition="'$(OutputName)' == ''">md-viewer-setup-$(InstallerPlatform)</OutputName>
    <OutputType>Package</OutputType>
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\publish\win-$(InstallerPlatform)</PublishDir>
    <DefineConstants>PublishDir=$(PublishDir)</DefineConstants>
    <SuppressValidation>true</SuppressValidation>
  </PropertyGroup>
</Project>
